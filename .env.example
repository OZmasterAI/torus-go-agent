# Agent
AGENT_PROVIDER=
AGENT_MODEL=

# Provider API Keys
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
# OpenAI: set OPENAI_API_KEY for API-billed usage. OR leave it blank and select
# the "openai" provider to "Sign in with ChatGPT" — a browser OAuth login that
# bills inference to your ChatGPT Plus/Pro/Team subscription instead of the API.
# Credentials are stored in ~/.torus/openai_auth.json and auto-refreshed.
# On a remote/VPS/headless box, set TORUS_OAUTH_HEADLESS=1 to skip the
# localhost:1455 callback and paste the redirect URL from your browser instead.
OPENAI_API_KEY=
# ChatGPT-subscription quick-start — uncomment these three to run with your
# ChatGPT plan (no API key). On a remote/VPS box keep TORUS_OAUTH_HEADLESS=1;
# on your own laptop you can omit it (the localhost login works there).
# AGENT_PROVIDER=openai
# AGENT_MODEL=gpt-5-codex        # only Codex-served models work: gpt-5-codex, gpt-5
# TORUS_OAUTH_HEADLESS=1         # paste-the-URL login; skips the localhost:1455 callback
XAI_API_KEY=
GEMINI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_RESOURCE=
AZURE_DEPLOYMENT=
AZURE_API_VERSION=

# Google Vertex AI
VERTEX_ACCESS_TOKEN=
VERTEX_PROJECT=
VERTEX_REGION=

# Telegram
TELEGRAM_BOT_TOKEN=

# HTTP Channel
TORUSGO_API_KEY=
TORUS_HTTP_PORT=8080
